# Core app configuration. Copy to .env.local and populate from the project owners.
# Clerk authenticates users; Supabase Auth is not used.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/id
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/auth/redirect

NEXT_PUBLIC_SUPABASE_URL=
# Server only. Never prefix this variable with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Project inquiry email (see SETUP_FOR_LUKE.md). All server only; none of these reach the browser.
# Inquiries are always saved; without these settings their emails wait in the queue.
RESEND_API_KEY=
INQUIRY_FROM_EMAIL=Mountline <hello@mountline.dev>
INQUIRY_REPLY_TO_EMAIL=hello@mountline.dev
INQUIRY_OWNER_EMAIL=luke.nordin@icloud.com
MOUNTLINE_SITE_URL=https://mountline.dev

# Vercel sends this as "Authorization: Bearer ..." to the scheduled email worker. 16+ random characters.
CRON_SECRET=
# Signing secret from the Resend webhook (starts with whsec_). Needed for delivery, bounce, and reply events.
RESEND_WEBHOOK_SECRET=
# Optional salt for rate-limit hashing of visitor IP addresses. Falls back to CRON_SECRET.
INQUIRY_HASH_SECRET=

# Follow-ups. Times are business days (Mon–Fri, holidays not skipped) in this time zone, sent from 9 AM.
INQUIRY_TIMEZONE=America/Chicago
INQUIRY_OWNER_REMINDER_BUSINESS_DAYS=1
INQUIRY_CHECKIN_BUSINESS_DAYS=3
# off | approval | automatic. "automatic" only takes effect when reply detection is on and working.
INQUIRY_CUSTOMER_FOLLOWUP=approval
# off | resend_inbound. Turn on only after the reply-forwarding test in SETUP_FOR_LUKE.md passes.
INQUIRY_REPLY_DETECTION=off

# No Retell, calendar, SMS, or payment API integration is enabled by this file.
# Signal research/alerts use optional provider settings documented in SIGNAL.md.
